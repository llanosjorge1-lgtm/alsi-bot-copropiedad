        "html": "=<div style=\"font-family:'Segoe UI',Tahoma,sans-serif;max-width:600px;margin:0 auto;background:#f8fafc;border-radius:12px;overflow:hidden;border:1px solid #e2e8f0;\">\n  <div style=\"background:linear-gradient(135deg,#059669,#10b981);padding:24px;text-align:center;\">\n    <h1 style=\"color:#fff;margin:0;font-size:22px;\">✅ Nueva Reunión Agendada</h1>\n    <p style=\"color:#d1fae5;margin:4px 0 0;font-size:14px;\">ALSI Administración Copropiedad — Portada Norte VII</p>\n  </div>\n  <div style=\"padding:24px;\">\n    <table style=\"width:100%;border-collapse:collapse;\">\n      <tr><td style=\"padding:8px 0;color:#64748b;width:140px;\">🏢 Condominio</td><td style=\"padding:8px 0;font-weight:bold;\">{{ $json.body?.condoName || $json.condoName || 'Condominio Portada Norte VII' }}</td></tr>\n      <tr><td style=\"padding:8px 0;color:#64748b;\">👤 Residente</td><td style=\"padding:8px 0;font-weight:bold;\">{{ $json.body?.clientName || $json.clientName }}</td></tr>\n      <tr><td style=\"padding:8px 0;color:#64748b;\">🏠 Departamento</td><td style=\"padding:8px 0;font-weight:bold;\">{{ $json.body?.unitNumber || $json.unitNumber }}</td></tr>\n      <tr><td style=\"padding:8px 0;color:#64748b;\">📋 Asunto</td><td style=\"padding:8px 0;font-weight:bold;\">{{ $json.body?.meetingReason || $json.meetingReason }}</td></tr>\n      <tr><td style=\"padding:8px 0;color:#64748b;\">📅 Fecha y Hora</td><td style=\"padding:8px 0;font-weight:bold;\">{{ $json.body?.dateTime || $json.dateTime }}</td></tr>\n      <tr><td style=\"padding:8px 0;color:#64748b;\">🎟️ Código Pase QR</td><td style=\"padding:8px 0;font-weight:bold;color:#059669;\">{{ $json.body?.voucherCode || $json.voucherCode || 'N/A' }}</td></tr>\n    </table>\n    <hr style=\"border:none;border-top:1px solid #e2e8f0;margin:16px 0;\">\n    <p style=\"color:#94a3b8;font-size:12px;text-align:center;margin:0;\">📧 Evento sincronizado automáticamente en Google Calendar • Bot ALSI IA</p>\n  </div>\n</div>"
