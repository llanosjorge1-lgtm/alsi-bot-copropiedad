{
  "name": "ALSI Copropiedad - Flujo Completo Automatización (Portada Norte VII)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alsi-copropiedad-event",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "1. Webhook Evento ALSI",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 400]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "rules": [
            {
              "value2": "MEETING_BOOKED",
              "operation": "equal"
            },
            {
              "value2": "MEETING_CANCELED",
              "operation": "equal"
            },
            {
              "value2": "INCIDENT_REPORTED",
              "operation": "equal"
            },
            {
              "value2": "PAYMENT_RECEIPT_SUBMITTED",
              "operation": "equal"
            }
          ]
        },
        "dataType": "string",
        "value1": "={{ $json.body.event }}",
        "fallbackOutput": "extra"
      },
      "name": "2. Switch por Tipo de Evento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [520, 400]
    },
    {
      "parameters": {
        "resource": "event",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "start": "={{ $json.body.startIso }}",
        "end": "={{ $json.body.endIso }}",
        "summary": "={{ $json.body.summary || ('Reunión: ' + $json.body.clientName + ' - Depto ' + $json.body.unitNumber + ' - Asunto: ' + $json.body.meetingReason) }}",
        "description": "={{ 'Reunión coordinada por Bot ALSI.\\nResidente: ' + $json.body.clientName + '\\nDepto: ' + $json.body.unitNumber + '\\nAsunto: ' + $json.body.meetingReason + '\\nVoucher QR: ' + ($json.body.voucherCode || 'N/A') }}",
        "additionalFields": {
          "attendees": ["contactoalsiadministracion@gmail.com"],
          "location": "Oficina ALSI - Condominio Portada Norte VII"
        }
      },
      "name": "3a. Crear Evento Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [820, 120],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "google-calendar-cred-alsi",
          "name": "Google Calendar ALSI Copropiedades"
        }
      }
    },
    {
