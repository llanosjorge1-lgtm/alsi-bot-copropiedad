      "name": "1. Webhook Evento ALSI",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 400]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "operation": "equal",
              "value1": "={{ $json.body?.event || $json.event }}",
              "value2": "MEETING_BOOKED"
            },
            {
              "operation": "equal",
              "value1": "={{ $json.body?.event || $json.event }}",
              "value2": "MEETING_CANCELED"
            },
            {
              "operation": "equal",
              "value1": "={{ $json.body?.event || $json.event }}",
              "value2": "INCIDENT_REPORTED"
            },
            {
              "operation": "equal",
              "value1": "={{ $json.body?.event || $json.event }}",
              "value2": "PAYMENT_RECEIPT_SUBMITTED"
            }
          ]
        },
        "fallbackOutput": "extra"
      },
      "name": "2. Switch por Tipo de Evento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [520, 400]
